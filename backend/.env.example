# Copy this file to backend/.env and fill in the values.
# backend/.env is in .gitignore. Real values are shared privately, never on GitHub.
# In production, set the same names in Render → Environment.

PORT=3000

# Signs login tokens. Use a long random value, different on your laptop and on Render:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Web pages allowed to call the API from a browser (comma-separated, no trailing slash).
# Add the deployed web app's address, e.g. https://newtsbrightside.github.io
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Hosted database (production only). Leave EMPTY on your laptop, so the server and
# `npm run seed` use the local file finishline.db and can never touch production data.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI Fit Advisor (https://openrouter.ai → Keys). Without a key the advisor answers
# with a "not available" message and a size-matched list instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
