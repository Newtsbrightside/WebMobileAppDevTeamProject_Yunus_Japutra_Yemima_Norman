# Copy to mobile-app/.env (it is in .gitignore). Restart `npx expo start` after changing it.
#
# The address of the Finishline API. EXPO_PUBLIC_ values are built INTO the app,
# so anyone can read them: an address is fine here, a secret never is.
#
# Deployed backend (use this for demos, mobile data and both phones):
#   EXPO_PUBLIC_API_URL=https://your-api.onrender.com
# Backend on your laptop: the phone cannot reach "localhost", use the laptop's Wi-Fi IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:3000
EXPO_PUBLIC_API_URL=http://192.168.1.23:3000
